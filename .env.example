# cp .env.example .env 후 값을 채운다. 토큰은 충분히 긴 임의 문자열(예: openssl rand -hex 32).
POSTGRES_PASSWORD=
SWINV_INGEST_TOKENS=    # 에이전트가 쓰는 수집 전용 토큰(쉼표로 여러 개 — 로테이션 시 새 토큰을 먼저 추가)
SWINV_READ_TOKENS=      # 화면·조회 API
SWINV_ADMIN_TOKENS=     # 태그 수정·호스트 삭제
#SWINV_STALE_AFTER_HOURS=48
#SWINV_BIND=127.0.0.1
#SWINV_PORT=8000

# AI 리포트(설정 화면에서 엔드포인트·모델·키를 입력한다). 아래는 선택 사항.
#SWINV_SECRET_KEY=            # 설정 암호화 키(Fernet). 권장: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
#SWINV_AI_ENDPOINT_ALLOWLIST=llm.corp.example   # 허용할 AI 엔드포인트 호스트(쉼표). 설정하면 그 외 호스트는 저장 거부
#OPENAI_API_KEY=               # 설정 화면에 키가 없을 때 쓰는 폴백

# 서버 등록(설치 명령)에 들어갈 주소. 리버스 프록시 뒤라면 반드시 지정한다(미지정이면 접속한 주소를 쓴다).
#SWINV_PUBLIC_URL=https://inventory.corp.example
# Windows exe 빌드를 건너뛰려면(빠른 검증): WITH_WINDOWS=0 docker compose up -d --build
#WITH_WINDOWS=1
