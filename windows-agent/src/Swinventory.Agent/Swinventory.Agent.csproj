<Project Sdk="Microsoft.NET.Sdk">
  <!-- 표준 라이브러리(BCL)만 사용한다 — NuGet 의존성 0. 테스트 프로젝트만 xUnit 을 쓴다. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>swinventory-agent</AssemblyName>
    <RootNamespace>Swinventory.Agent</RootNamespace>
    <!-- JSON 은 source generator 로만 처리(리플렉션 없음) → 트리밍 안전 -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Swinventory.Agent.Tests" />
  </ItemGroup>
</Project>
